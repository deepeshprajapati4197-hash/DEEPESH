datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

// 1. User Table (The Shop Owner Account)
model User {
  id         String    @id @default(uuid())
  email      String    @unique
  password   String
  name       String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// 2. Customer Table (Audit fields included as PLAIN STRINGS - 0 links to User)
model Customer {
  id               String        @id @default(uuid())
  name             String
  phone            String?
  currentBalance   Decimal       @default(0.00) @db.Decimal(12, 2)
  lastTransactionAt DateTime?
  
  // Timestamps
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?     

  // Audit Fields (Kept as plain text markers exactly as you requested!)
  createdBy        String
  updatedBy        String?
  deletedBy        String?

  // Only links down to the ledger entries sheet
  transactions     Transaction[] 

  @@unique([phone, createdBy]) 
  @@index([createdBy]) 
}

// 3. Transaction Table (Audit fields included as PLAIN STRINGS - 0 links to User)
model Transaction {
  id              String          @id @default(uuid())
  amount          Decimal         @db.Decimal(12, 2) 
  type            TransactionType
  description     String?
  balanceSnapshot Decimal         @db.Decimal(12, 2)
  
  // Timestamps
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  deletedAt       DateTime?       

  // Audit Fields (Kept as plain text markers exactly as you requested!)
  createdBy       String
  updatedBy       String?
  deletedBy       String?
  
  // Clean single connection linking to the target customer account profile
  customerId      String
  customer        Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt]) 
}

enum TransactionType {
  YOU_GAVE 
  YOU_GOT  
}
